{
  "name": "roundhouse",
  "version": "0.1.0",
  "description": "Personal followed-stream viewer, powered by KickTalk and mpv",
  "contributors": [
    {
      "name": "Dark",
      "email": "thedrkdesign@gmail.com",
      "url": "https://x.com/drkerco"
    },
    {
      "name": "ftk789",
      "email": "lolt04588@gmail.com",
      "url": "https://x.com/ftk789yt"
    }
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint src utils scripts tests --ext .js,.jsx,.cjs,.mjs --quiet",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "start": "cross-env NODE_ENV=production electron-vite preview",
    "dev": "cross-env NODE_ENV=development electron-vite dev",
    "dev-hr": "cross-env NODE_ENV=development electron-vite dev --watch",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "node scripts/package.cjs dir",
    "build:win": "node scripts/package.cjs nsis",
    "build:native": "node scripts/build-native.cjs",
    "setup:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mpv.ps1",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:native": "node scripts/test-native.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@lexical/react": "^0.30.0",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.8.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.1",
    "electron-util": "^0.18.1",
    "emoji-picker-react": "^4.12.2",
    "lexical": "^0.30.0",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.4.0",
    "react-virtuoso": "^4.12.7",
    "tldts": "^7.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "node-gyp": "^11.4.2",
    "prettier": "^3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass-embedded": "^1.87.0",
    "vite": "^6.1.0"
  },
  "productName": "Roundhouse"
}
